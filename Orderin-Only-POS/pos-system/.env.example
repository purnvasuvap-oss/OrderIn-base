# Optional overrides — src/lib/firebase.js already defaults to the same
# Firebase project ("orderin-7f8bc") used by the other Orderin apps in this
# repo, so this app connects out of the box with no .env required. Set these
# only if you want this app to point at a *different* Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
