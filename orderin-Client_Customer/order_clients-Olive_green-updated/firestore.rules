rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Scoped to the app's actual data model (Restaurant/{id}/...). This app has
    // no Firebase Auth session, so per-user rules aren't possible without a
    // backend auth rework; scoping to this subtree at least prevents access to
    // any unrelated top-level data.
    match /Restaurant/{restaurantId}/{document=**} {
      allow read, write: if true;
    }
    // Internal settlement-reconciliation queue: written only by Cloud Functions
    // via the Admin SDK, which bypasses these rules entirely. No client needs it.
    match /razorpaySettlementQueue/{docId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
