exports[`OrderInAbout > matches the snapshot 1`] = `
<DocumentFragment>
  <div
    class="orderin-about-container"
  >
    <div
      class="back-button-container"
    >
      <button
        aria-label="Back to Menu"
        class="back-button-top"
      >
        ← Back to Home
      </button>
    </div>
    <header
      class="orderin-header"
    >
      <img
        alt="OrderIn Logo"
        class="logo"
        src="/OrderIn.png"
      />
      <p
        class="by-text"
      >
        By
      </p>
      <img
        alt="Company Logo"
        class="Clogo"
        src="/company-logo.png"
      />
    </header>
    <main
      class="orderin-main"
    >
      <section
        class="orderin-section animated-section animated-section-delay-1"
      >
        <div
          class="about-header"
        >
          <h2>
            About
          </h2>
          <img
            alt="OrderIn Logo"
            class="logo2"
            src="/OrderIn.png"
          />
        </div>
        <p>
          OrderIn is a comprehensive ordering support and CRM platform designed to streamline business operations.
        </p>
      </section>
      <section
        class="orderin-section animated-section animated-section-delay-2"
      >
        <h2>
          Our Services
        </h2>
        <div
          class="services-grid"
        >
          <div
            class="service-card with-image"
          >
            <img
              alt="Bill Generation"
              class="service-img"
              src="/bill-generation.jpeg"
            />
            <div
              class="service-content"
            >
              <h3>
                Bill Generation
              </h3>
              <p>
