# Copy to .env.local for local builds. Do not commit real secrets.

# Passcode mode (default): required for admin console login when Firebase Auth
# is not enabled. Must match the deployed hosting build.
# Live orderin-admin.web.app currently expects: 12345678
VITE_ADMIN_PASSCODE=12345678

# Set to true to require Firebase Auth instead of the passcode.
# The signed-in user must have custom claim role = platformAdmin or owner.
# Also add every hosting domain (including orderin-admin.web.app) under
# Firebase Console → Authentication → Settings → Authorized domains.
VITE_USE_FIREBASE_AUTH=false

# Public Razorpay key id only. Never put the Razorpay secret in this app.
VITE_RAZORPAY_KEY_ID=
