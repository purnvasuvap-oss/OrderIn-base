# Public Firebase web config. Copy to .env.local.
# Sign in with a Firebase Auth user whose custom claim role is platformAdmin or owner.
# There is no passcode.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orderin-7f8bc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orderin-7f8bc
VITE_FIREBASE_STORAGE_BUCKET=orderin-7f8bc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public Razorpay key id only. Never put the secret in this app.
VITE_RAZORPAY_KEY_ID=
