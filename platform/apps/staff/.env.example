# Public Firebase web config. Copy to .env.local. Do not put passwords or Razorpay secrets here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orderin-7f8bc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orderin-7f8bc
VITE_FIREBASE_STORAGE_BUCKET=orderin-7f8bc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty. A real DSN is created in Sentry and set only on the deployed site.
VITE_SENTRY_DSN=

# Print bridge on the restaurant PC or Android device. See docs/PRINTING.md.
VITE_PRINT_BRIDGE_URL=http://127.0.0.1:9101/print

VITE_FUNCTIONS_BASE=
VITE_CUSTOMER_ORIGIN=https://orderin-customer.web.app
