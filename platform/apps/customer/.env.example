# Public Firebase web config. These are not secret. Copy to .env.local to override.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=orderin-7f8bc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=orderin-7f8bc
VITE_FIREBASE_STORAGE_BUCKET=orderin-7f8bc.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave empty until you create a Sentry project. Do not paste a real DSN into git.
VITE_SENTRY_DSN=

# Optional. Defaults to https://us-central1-<project>.cloudfunctions.net
VITE_FUNCTIONS_BASE=
