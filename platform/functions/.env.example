# Copy this file to .env on the machine you deploy from.
# Do not commit the filled-in file. Do not put the old leaked Razorpay key back.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One-time secret used by bootstrapAccount to create the first owner
# and the platform admin. Delete this after those accounts exist.
BOOTSTRAP_SECRET=

# Optional extra browser origins for the payment HTTP functions, comma-separated.
# localhost and *.web.app / *.firebaseapp.com are already allowed.
ALLOWED_ORIGINS=
