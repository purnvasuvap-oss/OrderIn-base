# Production: set these in Firebase, not in a committed file:
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# A local .env in this folder is only for the emulator. Do not commit it.
# Copy to .env in this functions folder. Do not commit the copy.
# Rotate the old live key in the Razorpay dashboard first. The values that
# used to be hardcoded in index.js are rejected even if you paste them here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional extra browser origins, comma-separated. localhost and *.web.app
# are already allowed.
ALLOWED_ORIGINS=
