# Razorpay settings for every OrderIn app.
#
# 1. Copy this file to razorpay-config/razorpay.env (that file is gitignored).
# 2. Fill in the values.
# 3. Run:  node razorpay-config/sync.js
#    It writes RAZORPAY_KEY_ID into each staff app's functions/.env and
#    VITE_RAZORPAY_KEY_ID into orderin_admin/.env.local. Both are gitignored.
#
# Never put real values in this .example file or anywhere else in the repo.

# Public key ID from Razorpay Dashboard > Account & Settings > API Keys.
# Payers see it at checkout, but it still lives here and not in code.
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX

# The key SECRET is NOT stored here for deploys. It lives in Google Secret Manager:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
# Fill this in only to run the Functions emulator locally. sync.js then
# writes it to functions/.secret.local, which is gitignored.
RAZORPAY_KEY_SECRET=

# Optional: webhook secret, used only if razorpayWebhook is deployed.
RAZORPAY_WEBHOOK_SECRET=
